# Stripe-hosted Checkout is created on the server. Use a restricted key with
# Checkout Sessions write access rather than exposing any key to the browser.
STRIPE_SECRET_KEY=rk_live_replace_me
CHORDLINK_STRIPE_PRICE_ID=price_replace_me

# Public availability endpoint on the Supabase backend. Required for sales: its database-backed
# switch is authoritative, and Checkout fails closed when the response cannot be read.
CHORDLINK_AVAILABILITY_URL=https://yajuszqvdglypabhzdrt.supabase.co/functions/v1/chordlink-availability

# chordlink availability notifications. The list lives at Brevo, whose double opt-in sends the
# confirmation, records the consent, and owns unsubscribing; nothing is stored on this site. The
# form is only rendered when the key, the template, and the list for the current state are all set,
# so a partial configuration shows no form rather than dropping addresses.
BREVO_API_KEY=xkeysib_replace_me
BREVO_INTEREST_DOI_TEMPLATE_ID=1
# Signups taken before the first edition goes on sale.
BREVO_INTEREST_LIST_ID=2
# Signups taken once the edition has sold out — a separate list so the restock mail cannot go to
# people who are still waiting for the first sale, or the other way round.
BREVO_WAITLIST_LIST_ID=3

# Sign-in for the internal tools (/emails, /translations, /screens, /social/*, /copy, /gallery).
# Both values are safe in the browser: the publishable key is meant to be shipped to clients and
# what it may do is decided by row-level security, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Who may open those pages, comma-separated. Being signed in is not enough — a Supabase project
# accepts new sign-ups by default, so without this an account anyone created would be an admin.
# Unset means nobody, never everybody.
ADMIN_EMAILS=you@example.com
